# ---------------------------------------------------------------------------
# EventHub environment configuration - copy to `.env` and edit the values.
#   cp .env.example .env
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Security ---------------------------------------------------------------
# REQUIRED in production: generate with
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://events.example.com
DJANGO_TIME_ZONE=Asia/Kolkata

# Database ---------------------------------------------------------------
# sqlite (default, zero config) or postgres
# DB_ENGINE=sqlite
# DB_NAME=db.sqlite3
PostgreSQL example:
DB_ENGINE=postgres
DB_NAME=eventhub
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Email ------------------------------------------------------------------
# Development prints password-reset emails to the console.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EventHub <no-reply@eventhub.local>
# Production example:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True

# Platform ---------------------------------------------------------------
SITE_NAME=EventHub
SITE_TAGLINE=Discover, organise and run memorable events.
EVENTS_PER_PAGE=9
TABLE_PER_PAGE=15

# Hardening applied automatically when DJANGO_DEBUG=False -----------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
